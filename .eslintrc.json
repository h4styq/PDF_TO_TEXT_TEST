{
  "env": {
    "googleappsscript/googleappsscript": true
  },
  "plugins": ["googleappsscript"],
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none", "varsIgnorePattern": "^(onOpen|runProcessFolder|runProcessFolderForSpreadsheet|showRecognitionSetupHelp|extractAfterLabel_|runGoldenCheckDart4230_|runGoldenCheckEpribor11400_)$" }],
    "no-undef": "error",
    "no-redeclare": "warn",
    "no-prototype-builtins": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }]
  },
  "overrides": [
    {
      "files": ["*.gs"],
      "globals": {
        "MimeType": "readonly"
      }
    }
  ]
}
